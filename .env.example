# ============================================
# AI Companion — Environment Configuration
# ============================================
# Copy this file to .env and fill in your keys.
# .env is gitignored and should never be committed.

# ============================================
# LLM (character dialogue agent)
# ============================================
# Supports any OpenAI-compatible API or native Anthropic SDK.
#
# Examples:
#   DeepSeek:      LLM_PROVIDER=deepseek  LLM_MODEL=deepseek-chat
#   Qwen:          LLM_PROVIDER=qwen      LLM_MODEL=qwen-plus
#   ZhipuAI:       LLM_PROVIDER=zhipu     LLM_MODEL=glm-4-flash
#   OpenAI:        LLM_PROVIDER=openai    LLM_MODEL=gpt-4o
#   Anthropic:     LLM_PROVIDER=anthropic LLM_MODEL=claude-sonnet-4-20250514
#   Ollama local:  LLM_PROVIDER=custom    LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=sk-your-key-here

# ============================================
# Vision Agent (screen understanding)
# ============================================
# Leave VISION_API_KEY empty to disable the see_screen tool.
# DeepSeek does NOT support vision.
#
# Examples:
#   Qwen-VL:        VISION_PROVIDER=qwen      VISION_MODEL=qwen-vl-max
#   GPT-4o-mini:    VISION_PROVIDER=openai    VISION_MODEL=gpt-4o-mini
#   Claude Haiku:   VISION_PROVIDER=anthropic VISION_MODEL=claude-haiku-4-5-20251001

VISION_PROVIDER=
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=

# ============================================
# Search Settings
# ============================================
# DuckDuckGo may be blocked in China; default fallback is bing_web (free, no key).
# Options: duckduckgo | searxng | bing | bing_web
SEARCH_BACKEND=duckduckgo
# SEARCH_PROXY=http://127.0.0.1:7890

# ============================================
# Server Settings
# ============================================
HOST=127.0.0.1
PORT=8722
MAX_CONTEXT_TOKENS=16000

# ============================================
# Location & Weather (Amap / 高德地图)
# ============================================
# Get a free key at https://console.amap.com/dev/key/app
# Choose "Web服务" as the platform type.
# Leave empty to disable.
AMAP_API_KEY=
# Manual city fallback if IP geolocation fails:
# USER_CITY=Beijing

# ============================================
# TTS — GPT-SoVITS (voice cloning)
# ============================================
# Path to GPT-SoVITS installation root.
# Run setup-tts.bat to auto-install, or set path manually.
# Set to empty to disable voice synthesis.
TTS_REF_BASE=./tools/GPT-SoVITS/GPT-SoVITS
