# ============================================
# AI Companion - Environment Configuration
# ============================================
# Copy this file to .env and fill in your keys.

# ============================================
# LLM (character dialogue agent)
# ============================================
# 4 variables. Works with any OpenAI-compatible API or native Anthropic.
#
# Preset examples:
#   DeepSeek:      provider=deepseek  model=deepseek-chat
#   Qwen:          provider=qwen      model=qwen-plus
#   ZhipuAI:       provider=zhipu     model=glm-4-flash
#   Moonshot:      provider=moonshot  model=moonshot-v1-8k
#   OpenAI:        provider=openai    model=gpt-4o
#   Anthropic:     provider=anthropic model=claude-sonnet-4-20250514
#   Ollama local:  provider=custom    base_url=http://localhost:11434/v1  model=qwen2.5:7b

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=sk-...

# ============================================
# Vision Agent (specialist for screen understanding)
# ============================================
# Leave VISION_API_KEY empty to disable the see_screen tool.
# DeepSeek does NOT support vision — use Qwen-VL / GPT-4o-mini / Claude Haiku / GLM-4V.
#
# Examples:
#   Qwen-VL:        provider=qwen      model=qwen-vl-max
#   GPT-4o-mini:    provider=openai    model=gpt-4o-mini
#   Claude Haiku:   provider=anthropic model=claude-haiku-4-5-20251001
#   GLM-4V Flash:   provider=zhipu     model=glm-4v-flash    (cheap, Chinese)

VISION_PROVIDER=
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=

# ============================================
# Server Settings
# ============================================
HOST=127.0.0.1
PORT=8722
MAX_CONTEXT_TOKENS=8000
