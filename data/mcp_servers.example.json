{
  "_note": "Rename this file to mcp_servers.json to enable MCP tools. The app reads data/mcp_servers.json on startup.",

  "servers": [
    {
      "name": "zhipu-vision",
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "deepseek_vision_mcp"],
      "env": {
        "ZHIPU_API_KEY": "your-zhipu-api-key-here"
      }
    },
    {
      "name": "amap",
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "amap_mcp_server"],
      "env": {
        "AMAP_MAPS_API_KEY": "your-amap-api-key-here"
      }
    }
  ]
}
